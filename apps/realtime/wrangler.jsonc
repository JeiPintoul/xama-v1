{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xama-realtime-cf0",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
    "ALLOW_CLIENT_PROVIDER_OVERRIDE": "false",
    "LIVEKIT_ENABLED": "true",
    "LIVEKIT_HEALTH": "healthy",
    "CLOUDFLARE_ENABLED": "true",
    "CLOUDFLARE_HEALTH": "healthy",
    "CLOUDFLARE_ACCOUNTING_BITS_PER_SECOND_PER_PULL": "12000000",
    "CLOUDFLARE_SOFT_BUDGET_BYTES": "5368709120",
    "CLOUDFLARE_HARD_BUDGET_BYTES": "8589934592",
    "CLOUDFLARE_GLOBAL_PULL_CAP": "6",
    "CLOUDFLARE_PULL_LEASE_SECONDS": "40",
    "CLOUDFLARE_BILLING_CYCLE_ID": "development-manual-1",
    "CLOUDFLARE_BILLING_CYCLE_START": "2026-08-25T00:00:00Z",
    "MAX_PARTICIPANTS_PER_ROOM": "12",
    "MAX_SCREEN_SHARES_PER_PARTICIPANT": "1",
    "MAX_SCREEN_SHARES_PER_ROOM": "4",
    "MAX_REMOTE_PULLS_PER_PARTICIPANT": "4",
    "MAX_REMOTE_PULLS_PER_ROOM": "24",
  },
  "ratelimits": [
    {
      "name": "JOIN_RATE_LIMITER",
      "namespace_id": "920001",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "CONTROL_RATE_LIMITER",
      "namespace_id": "920002",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomCoordinator",
      },
      {
        "name": "SPEND_GUARD",
        "class_name": "SpendGuard",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomCoordinator"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SpendGuard"],
    },
  ],
}
