{
  "name": "@xama/workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @xama/web dev",
    "build": "pnpm typecheck && pnpm --filter @xama/web build && pnpm --filter @xama/realtime build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
