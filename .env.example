# Public endpoint for the deployed Supabase livekit-token Edge Function.
# Do not add LiveKit API credentials or XAMA_ALPHA_CODE to browser environment files.
VITE_LIVEKIT_TOKEN_ENDPOINT=https://your-project.supabase.co/functions/v1/livekit-token

# Public endpoint for the deployed Quick Share room Edge Function.
# Never place LiveKit credentials in browser environment files.
VITE_QUICK_ROOM_ENDPOINT=https://your-project.supabase.co/functions/v1/quick-room

# Development/test override. Unset or automatic keeps the existing LiveKit Quick Share path.
VITE_MEDIA_PROVIDER=automatic

# Public URL of apps/realtime. Cloudflare App credentials stay in the Worker only.
VITE_REALTIME_ENDPOINT=http://localhost:8787
